# Local development defaults
PORT=5001
NODE_ENV=development
AUTOMATEX_ENV=development

# Required for backend auth
MONGODB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
ALLOWED_ORIGINS=http://localhost:5001,https://automatex.com
PUBLIC_APP_URL=https://automatex.com
CLIENT_DASHBOARD_URL=https://automatex.com/dashboard
PASSWORD_RESET_URL=https://automatex.com/reset-password

# File storage
# Local storage is for development only. Use STORAGE_DRIVER=s3 for staging and production.
STORAGE_DRIVER=local
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Cloudflare R2: auto
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for private backend-streamed downloads.
S3_PUBLIC_BASE_URL=
# Cloudflare R2: true for staging/production R2 buckets
S3_FORCE_PATH_STYLE=false

# Optional integrations
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AutomateX <no-reply@automatex.com>
SUPPORT_EMAIL=support@automatex.com
OPENAI_API_KEY=sk_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_STANDARD_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# POS licensing is disabled and unmounted by default. These are placeholders only.
POS_LICENSING_MODE=disabled
POS_LICENSING_ENABLED=false
# Temporary staging-only public-key diagnostic. Keep disabled and leave the token empty by default.
POS_LICENSING_STAGING_PUBLIC_KEY_DIAGNOSTIC_ENABLED=false
POS_LICENSING_STAGING_PUBLIC_KEY_DIAGNOSTIC_TOKEN=
# Temporary staging-only activation eligibility diagnostic. Keep disabled and leave the token empty by default.
POS_LICENSING_STAGING_ACTIVATION_ELIGIBILITY_ENABLED=false
POS_LICENSING_STAGING_ACTIVATION_ELIGIBILITY_TOKEN=
# Temporary one-time staging-only administrator bootstrap. Keep disabled and leave the token empty by default.
POS_LICENSING_STAGING_ADMIN_BOOTSTRAP_ENABLED=false
POS_LICENSING_STAGING_ADMIN_BOOTSTRAP_TOKEN=
# Server-only production contract (inject at runtime; do not place real secrets in this file):
# POS_LICENSING_DATABASE_NAME=automatex_pos_production
# POS_LICENSING_ENVIRONMENT=production
# POS_LICENSING_CLIENT_SCOPE=production-only
# POS_LICENSING_SECRET_ENVIRONMENT=production
# POS_LICENSING_SECRET_SOURCE=secret-manager
# MONGO_URI=<authenticated TLS POS MongoDB URI with an explicit matching database>
# POS_LICENSING_SIGNING_PRIVATE_JWK_B64=<secret-manager supplied base64 JSON JWK>
# POS_LICENSING_EXPECTED_PUBLIC_JWK=<injected approved public-only JSON JWK>
# POS_LICENSING_SIGNING_KEY_ID=automatex-pos-prod-ed25519-v1
# POS_LICENSING_MACHINE_API_BASE_PATH=/api/pos-machine/v1
# POS_LICENSING_MACHINE_API_ORIGIN=https://licensing.example.invalid
# POS_LICENSING_PRODUCTION_HOSTNAME=licensing.example.invalid
# POS_LICENSING_STAGING_HOSTNAME=licensing-staging.example.invalid
# POS_LICENSING_PROXY_TRUST_MODE=vercel
# Use vercel only for verified Vercel Preview staging or Vercel Production production; use direct or cidr elsewhere.
# POS_LICENSING_TRUSTED_PROXY_CIDRS=<approved bounded proxy CIDRs; only when mode=cidr>
# POS_LICENSING_PRODUCTION_ADMIN_ORIGINS=https://approved-production-company-system-origin.example
# POS_LICENSING_STAGING_ADMIN_ORIGINS=https://approved-staging-company-system-origin.example
# POS_LICENSING_MACHINE_ALLOWED_ORIGINS=none
# POS_LICENSING_RATE_LIMIT_BACKEND=upstash-rest
# POS_LICENSING_RATE_LIMIT_STORE_IDENTITY=automatex-pos-production-distributed-v1
# POS_LICENSING_RATE_LIMIT_NAMESPACE=automatex:pos-licensing:production
# UPSTASH_REDIS_REST_URL=<secret-manager supplied HTTPS REST endpoint>
# UPSTASH_REDIS_REST_TOKEN=<secret-manager supplied REST token>
# POS_LICENSING_RATE_LIMIT_STORE_URI=<only for a different approved adapter that requires a URI>
# POS_LICENSING_RATE_LIMIT_WINDOW_MS=60000
# POS_LICENSING_ACTIVATION_RATE_LIMIT=10
# POS_LICENSING_BOOTSTRAP_RATE_LIMIT=20
# POS_LICENSING_RENEWAL_RATE_LIMIT=60
# POS_LICENSING_AUDIT_ENABLED=true
# POS_LICENSING_AUDIT_RETENTION=indefinite
# POS_LICENSING_MONGODB_TRANSACTIONS_REQUIRED=true
